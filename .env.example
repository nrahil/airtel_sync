# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# development | test | production
ENVIRONMENT=development

# --- Groq LLM (advisor only; receives PII-redacted text) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Leave GROQ_API_KEY empty to run the advisor on templates + the guided form only.
GROQ_TIMEOUT_SECONDS=8
GROQ_MAX_TOKENS=400
# Advisor guard-rails: chat turns before hand-off to the form, message length, per-IP rate.
ADVISOR_MAX_TURNS=20
ADVISOR_MAX_MESSAGE_CHARS=500
ADVISOR_RATE_PER_MINUTE=30

# --- Crypto material (>= 32 chars each; required in production) ---
# MASTER_KEY never encrypts data itself: it derives purpose keys and the key that wraps
# each person's own data key (crypto-shredded on erasure). Losing it = losing all sealed data.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MASTER_KEY=
QUOTE_HMAC_KEY=

# --- Deterministic "today" for all date rules (dataset today = 2026-07-15).
# Leave empty to use the real IST date. Forbidden in production.
TODAY_OVERRIDE=2026-07-15

# --- Local OCR ---
# Full path if `tesseract` is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract
# Set false only for local dev without OCR (health shows "degraded").
TESSERACT_REQUIRED=true

# --- Data ---
# Provided read-only dataset. Default: <repo>/mock_data. Docker uses /srv/mock_data.
# DATA_DIR=../mock_data
# Application state DB. Relative sqlite paths resolve from the working directory.
DATABASE_URL=sqlite:///data/udyam.db

# --- Registry lookups (GSTIN / Udyam) ---
LOOKUP_RATE_PER_MINUTE=10        # per person (anti-enumeration)
LOOKUP_IP_RATE_PER_MINUTE=30     # per client IP
LOOKUP_TIMEOUT_MS=2000
# Resilience testing only — forbidden in production. off | down | flaky
LOOKUP_FAULT_MODE=off
LOOKUP_LATENCY_MS=0
LOOKUP_FAILURE_RATE=0.0

# --- Smart KYC ---
# Encrypted image blobs (AES-256-GCM, each person's own data key); never served directly.
KYC_STORAGE_DIR=data/kyc_blobs
KYC_UPLOAD_RATE_PER_MINUTE=20    # per person
KYC_IP_RATE_PER_MINUTE=60        # per client IP
KYC_RAW_IMAGE_RETENTION_DAYS=7   # raw images deleted this long after activation/drop/withdrawal
KYC_ABANDONED_AFTER_DAYS=30      # no live order + no activity this long = dropped
# Run the retention job daily: python -m scripts.retention_job
KYC_HANDOFF_AFTER_FAILURES=3     # failed submissions before partner/field hand-off

# --- Back office (staff console at /<locale>/backoffice) ---
# Create users with `python -m scripts.create_staff --username NAME --role sales|partner|kyc_reviewer|ops|admin`
# (password from STAFF_PASSWORD or a prompt). Non-production demo users (sales, partner,
# reviewer, admin): set BACKOFFICE_DEMO_PASSWORD (12+ chars) and run `--demo`.
# BACKOFFICE_DEMO_PASSWORD=
STAFF_TOKEN_TTL_MINUTES=480
STAFF_LOGIN_MAX_FAILURES=5       # then the account is locked
STAFF_LOCKOUT_MINUTES=15
BACKOFFICE_IDLE_MINUTES=30       # an advisor session idle this long counts as unclosed
BACKOFFICE_REVEAL_RATE_PER_HOUR=60
# Propensity model (JSON). Trained on first use if missing; or run `python -m scripts.train_propensity`.
PROPENSITY_MODEL_PATH=data/propensity_model.json

# Principal (session) token lifetime, minutes
PRINCIPAL_TOKEN_TTL_MINUTES=60

# --- Security & privacy (Phase 9) ---
# Exact browser origins (JSON list). No wildcards; https only in production (loopback excepted).
CORS_ORIGINS=["http://localhost:3000"]
API_IP_RATE_PER_MINUTE=300       # backstop on every /api/v1 route, per client IP
OTP_PHONE_MAX_FAILURES=10        # wrong OTP codes across challenges before the phone locks
OTP_LOCKOUT_MINUTES=60
PRIVACY_RATE_PER_MINUTE=10       # export / correction / erasure, per person
